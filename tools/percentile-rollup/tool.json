{
  "sdk": 5,
  "id": "percentile-rollup",
  "name": "Percentiles across hosts",
  "blurb": "Paste latency histograms from Prometheus, Google Cloud, AWS X-Ray or a log query, or raw latencies. See the service's real p99, how far off it can be, and how wrong the averaged per-host p99 is.",
  "version": "3.0.1",
  "capabilities": [
    "pure"
  ],
  "runtime": {
    "entry": "index.ts",
    "thread": "main"
  },
  "kinds": [
    "group",
    "fields",
    "series",
    "table",
    "code",
    "error"
  ],
  "card": "live",
  "cardFields": 3,
  "help": "README.md",
  "tags": [
    "latency",
    "percentiles",
    "prometheus",
    "histograms",
    "observability"
  ],
  "inputs": [
    {
      "id": "values",
      "type": "textarea",
      "label": "Latency histogram, or raw latencies",
      "description": "Paste any one of these; the format is detected.\n- Prometheus: bucket lines such as x_bucket{instance=\"a\",le=\"0.05\"} 120, the query API's JSON (Amazon's and Azure's managed Prometheus too), or a CSV of instance,le,count with cumulative counts.\n- Google Cloud Monitoring: the timeSeries.list JSON of a distribution metric.\n- AWS X-Ray: the JSON from GetTimeSeriesServiceStatistics or GetServiceGraph.\n- Azure Log Analytics or CloudWatch Logs Insights: a query result of duration bins and counts, as CSV or JSON.\n- Anything else: raw latencies, a group per host separated by a blank line, as in host 1: 12 14 15.",
      "primary": true,
      "rows": 12,
      "dir": "ltr",
      "maxLength": 400000,
      "default": "# TYPE http_request_duration_seconds histogram\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.005\"} 0\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.01\"} 599\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.025\"} 18306\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.05\"} 24790\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.1\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.25\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"0.5\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"1\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"2.5\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"5\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"10\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-1\",le=\"+Inf\"} 24896\nhttp_request_duration_seconds_sum{instance=\"host-1\"} 530.211\nhttp_request_duration_seconds_count{instance=\"host-1\"} 24896\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.005\"} 2\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.01\"} 597\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.025\"} 18564\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.05\"} 25093\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.1\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.25\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"0.5\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"1\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"2.5\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"5\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"10\"} 25196\nhttp_request_duration_seconds_bucket{instance=\"host-2\",le=\"+In