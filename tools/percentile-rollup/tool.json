      "id": "percentile",
      "type": "select",
      "label": "Percentile",
      "description": "Which percentile to estimate across every instance.",
      "primary": true,
      "default": "p99",
      "options": [
        {
          "value": "p50",
          "label": "p50"
        },
        {
          "value": "p90",
          "label": "p90"
        },
        {
          "value": "p95",
          "label": "p95"
        },
        {
          "value": "p99",
          "label": "p99"
        },
        {
          "value": "p99.9",
          "label": "p99.9"
        }
      ]
    },
    {
      "id": "threshold",
      "type": "number",
      "label": "Threshold",
      "description": "The promise to count against, in the same units as the input: 0.1 is 100 ms when the edges are in seconds, as in Prometheus and X-Ray, and 100 is 100 ms for Cloud Monitoring or a KQL query in milliseconds.",
      "unit": "same units as the input",
      "default": 0.1,
      "min": 1e-06,
      "max": 1000000000,
      "step": 0.001
    }
