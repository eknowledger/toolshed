					"caption": "The name in UTF-8, one highlighted run per letter",
					"highlight": [
						{ "at": 0, "len": 2, "label": "U+0639 ʿayn" },
						{ "at": 2, "len": 2, "label": "U+0628 ba" },
						{ "at": 4, "len": 2, "label": "U+062F dal" },
						{ "at": 7, "len": 2, "label": "U+0627 alif" },
						{ "at": 9, "len": 2, "label": "U+0644 lam" },
						{ "at": 11, "len": 2, "label": "U+0631 ra" },
