						["ب", "ba", "U+0628", "D8 A8", "yes"],
						["د", "dal", "U+062F", "D8 AF", "no"],
						["ا", "alif", "U+0627", "D8 A7", "no"],
						["ل", "lam", "U+0644", "D9 84", "yes"],
						["ر", "ra", "U+0631", "D8 B1", "no"],
						["ح", "ḥa", "U+062D", "D8 AD", "yes"],
						["م", "mim", "U+0645", "D9 85", "yes"],
						["ن", "nun", "U+0646", "D9 86", "no"]
