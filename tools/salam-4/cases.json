[
	{
		"name": "the default name: four letters in two pieces, because أ never joins the letter after it",
		"input": { "name": "أحمد", "greeting": "ahlan", "ya": true },
		"expect": {
			"kind": "group",
			"parts": [
				{ "kind": "text", "text": "أهلاً يا أحمد" },
				{
					"kind": "fields",
					"fields": [
						{ "label": "Letters", "value": "4" },
						{ "label": "Pieces", "value": "2", "note": "أ · حمد" },
						{ "label": "UTF-8 bytes", "value": "8", "note": "two for each Arabic letter or mark, one for a space" }
					]
				},
				{
					"kind": "table",
					"caption": "Letter by letter",
					"columns": [
						{ "label": "Letter" },
						{ "label": "Name" },
						{ "label": "Code point", "mono": true },
						{ "label": "UTF-8", "mono": true },
						{ "label": "Joins the next" }
					],
					"rows": [
						["أ", "alif, hamza above", "U+0623", "D8 A3", "no"],
						["ح", "ḥa", "U+062D", "D8 AD", "yes"],
						["م", "mim", "U+0645", "D9 85", "yes"],
						["د", "dal", "U+062F", "D8 AF", "no"]
					]
				},
				{
					"kind": "bytes",
					"bytes": [216, 163, 216, 173, 217, 133, 216, 175],
					"caption": "The name in UTF-8, one highlighted run per letter",
					"highlight": [
						{ "at": 0, "len": 2, "label": "U+0623 alif, hamza above" },
						{ "at": 2, "len": 2, "label": "U+062D ḥa" },
						{ "at": 4, "len": 2, "label": "U+0645 mim" },
						{ "at": 6, "len": 2, "label": "U+062F dal" }
					]
				}
			]
		}
	},
	{
		"name": "a shadda is two more bytes and no more letters",
		"input": { "name": "محمّد", "greeting": "marhaban", "ya": true },
		"expect": {
			"kind": "group",
			"parts": [
				{ "kind": "text", "text": "مرحباً يا محمّد" },
				{
					"kind": "fields",
					"fields": [
						{ "label": "Letters", "value": "4" },
						{ "label": "Pieces", "value": "1", "note": "محمّد" },
						{ "label": "UTF-8 bytes", "value": "10", "note": "two for each Arabic letter or mark, one for a space" }
					]
				},
				{
					"kind": "table",
					"caption": "Letter by letter",
					"columns": [
						{ "label": "Letter" },
						{ "label": "Name" },
						{ "label": "Code point", "mono": true },
						{ "label": "UTF-8", "mono": true },
						{ "label": "Joins the next" }
					],
					"rows": [
						["م", "mim", "U+0645", "D9 85", "yes"],
						["ح", "ḥa", "U+062D", "D8 AD", "yes"],
						["مّ", "mim", "U+0645", "D9 85 D9 91", "yes"],
						["د", "dal", "U+062F", "D8 AF", "no"]
					]
				},
				{
					"kind": "bytes",
					"bytes": [217, 133, 216, 173, 217, 133, 217, 145, 216, 175],
					"caption": "The name in UTF-8, one highlighted run per letter",
					"highlight": [
						{ "at": 0, "len": 2, "label": "U+0645 mim" },
						{ "at": 2, "len": 2, "label": "U+062D ḥa" },
						{ "at": 4, "len": 4, "label": "U+0645 mim + shadda U+0651" },
						{ "at": 8, "len": 2, "label": "U+062F dal" }
					]
				}
			]
		}
	},
	{
		"name": "a hamza joins neither neighbour, so هناء ends in a piece of its own",
		"input": { "name": "هناء", "greeting": "masa", "ya": false },
