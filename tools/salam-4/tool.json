{
  "sdk": 3,
  "id": "salam-4",
  "name": "Salam, step 4: a manifest that says more",
  "blurb": "Greets a name in Arabic, then shows its letters: how many, how they join, and the bytes UTF-8 spends on each.",
  "version": "4.0.0",
  "capabilities": ["pure"],
  "runtime": { "entry": "index.ts" },
  "kinds": ["group", "text", "fields", "table", "bytes", "error"],
  "card": "live",
  "cardFields": 3,
  "inputs": [
    {
      "id": "name",
      "type": "text",
      "label": "Name",
      "description": "In Arabic letters. Short vowels and shadda are fine.",
      "primary": true,
      "maxLength": 40,
      "default": "أحمد"
    },
    {
      "id": "greeting",
      "type": "select",
      "label": "Greeting",
      "default": "ahlan",
      "options": [
        { "value": "ahlan", "label": "أهلاً, welcome" },
        { "value": "marhaban", "label": "مرحباً, hello" },
        { "value": "salam", "label": "السلام عليكم, peace be upon you" },
        { "value": "sabah", "label": "صباح الخير, good morning" },
        { "value": "masa", "label": "مساء الخير, good evening" }
      ]
    },
    { "id": "ya", "type": "toggle", "label": "Call them by name, with يا", "default": true }
  ],
  "samples": [
    { "label": "Muhammad, with a shadda", "input": { "name": "محمّد" } },
    { "label": "Two words", "input": { "name": "عبد الرحمن" } },
    { "label": "Latin letters", "input": { "name": "Ahmed" } }
  ],
  "help": "README.md",
  "tags": ["arabic", "unicode", "example"],
  "links": [
    { "label": "Unicode Arabic block (U+0600 to U+06FF)", "href": "https://www.unicode.org/charts/PDF/U0600.pdf" }
  ]
}
