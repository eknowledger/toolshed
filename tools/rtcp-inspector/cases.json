  {
    "name": "the server's receiver report, with the time it arrived: the round trip",
    "input": {
      "packet": "81 c9 00 07 7a 3b 9c 5d 1f 2e 3d 4c 06 00 00 06 00 00 04 e1 00 00 00 82 d8 f0 40 00 00 00 fd 70 81 ca 00 06 7a 3b 9c 5d 01 10 73 2b 72 4e 4d 30 4d 37 4d 62 55 6c 49 31 45 44 00 00",
      "view": "fields",
      "arrival": "d8f1:4ccc"
    },
    "match": "subset",
    "fieldCount": 4,
    "why": "rtcp_reports.py: fraction lost 6 = 2.34%; LSR 0xd8f0:4000 (55536.250000 s); DLSR 0x0000:fd70, 64880 units, 0.990 s; A 0xd8f1:4ccc; \"round trip = A - LSR - DLSR = 3932 / 65536 s = 59.998 ms\"",
    "expect": {
      "kind": "fields",
      "fields": [
        {
          "group": "RR #1, block 1",
          "label": "Fraction lost",
          "value": "6/256 = 2.34%",
          "note": "truncated to 256ths: the true share is at least this, and less than 1/256 more"
        },
        {
          "group": "RR #1, block 1",
          "label": "LSR",
          "value": "0xD8F0:4000",
          "note": "55536.250000 s, the middle 32 bits of the SR this answers"
        },
        {
          "group": "RR #1, block 1",
          "label": "DLSR",
          "value": "0.990 s",
          "note": "64880 / 65536 s, 0x0000:FD70: how long the receiver held the SR before replying"
        },
        {
          "group": "RR #1, block 1",
          "label": "Round trip",
          "value": "59.998 ms",
          "note": "A - LSR - DLSR = 0xD8F1:4CCC - 0xD8F0:4000 - 0x0000:FD70 = 3932 / 65536 s"
        }
      ]
    }
  },
