    "match": "subset",
    "why": "pins the field values; the byte highlights and their offsets are asserted as invariants in index.test.ts, where a rule can say why it holds instead of restating eight offsets",
    "fieldCount": 8,
    "expect": {
      "kind": "fields",
      "fields": [
