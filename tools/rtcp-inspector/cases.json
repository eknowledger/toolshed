  {
    "name": "prose is named as prose, not filtered into nonsense",
    "input": {
      "packet": "hello there",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Not hex: found \"h\", \"l\", \"o\", \"t\", \"r\". Expected hex digits, optionally separated by spaces, colons or commas.",
      "input": "packet"
    }
  },
  {
    "name": "an odd number of hex digits cannot be bytes",
    "input": {
      "packet": "8000002a0",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Odd number of hex digits (9); a byte needs two.",
      "input": "packet"
    }
  },
  {
    "name": "a truncated packet says where it ran out",
    "input": {
      "packet": "8000002a0000",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Truncated: the RTP fixed header needs 12 bytes at offset 0, but the packet ends at 6.",
      "input": "packet",
      "at": 0,
      "len": 6
    }
  },
