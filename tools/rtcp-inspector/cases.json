      "view": "fields"
    },
    "match": "subset",
    "why": "finding the reason depends on comparing the cursor against the length field rather than the end of the packet, since the chunk is null-padded past it",
    "fieldCount": 8,
    "expect": {
      "kind": "fields",
      "fields": [
        {
          "label": "Leaving because",
          "value": "teardown",
          "group": "BYE"
        },
        {
          "label": "#1 BYE SSRC 1",
          "value": "0x11111111"
        },
        {
          "label": "#1 BYE reason",
          "value": "teardown"
        }
      ]
    }
