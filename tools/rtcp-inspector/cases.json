  {
    "name": "RFC 3550 Figure 2: the spec's own round trip",
    "input": {
      "packet": "81c90007 11111111 22222222 00000000 00000000 00000000 b7052000 00054000",
      "view": "fields",
      "arrival": "0xb710:8000"
    },
    "match": "subset",
    "fieldCount": 4,
    "why": "RFC 3550 section 6.4.1, Figure 2: A 0xb710:8000, LSR 0xb705:2000, DLSR 0x0005:4000, so the delay is 0x0006:2000 = 401408 / 65536 = 6.125 s. The packet is an RR built around those three values; its other fields are placeholders",
    "expect": {
      "kind": "fields",
      "fields": [
        {
          "group": "RR #1, block 1",
          "label": "Round trip",
          "value": "6.125 s",
          "note": "A - LSR - DLSR = 0xB710:8000 - 0xB705:2000 - 0x0005:4000 = 401408 / 65536 s"
        }
      ]
    }
  },
