  {
    "name": "BYE carries an optional, length-prefixed reason",
    "input": {
      "packet": "81cb0004111111110874656172646f776e000000",
      "view": "fields"
    },
    "match": "subset",
    "why": "finding the reason depends on comparing the cursor against the length field rather than the end of the packet, since the chunk is null-padded past it",
    "fieldCount": 8,
    "expect": {
      "kind": "fields",
      "fields": [
        {
          "label": "Leaving because",
          "value": "teardown",
          "group": "BYE"
        },
        {
          "label": "#1 BYE SSRC 1",
          "value": "0x11111111"
        },
        {
          "label": "#1 BYE reason",
          "value": "teardown"
        }
      ]
    }
  },
  {
    "name": "prose is named as prose, not filtered into nonsense",
    "input": {
      "packet": "hello there",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Not hex: found \"h\", \"l\", \"o\", \"t\", \"r\". Expected hex digits, optionally separated by spaces, colons or commas.",
      "input": "packet"
    }
  },
  {
    "name": "an odd number of hex digits cannot be bytes",
    "input": {
      "packet": "8000002a0",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Odd number of hex digits (9); a byte needs two.",
      "input": "packet"
    }
  },
  {
    "name": "a truncated packet says where it ran out",
    "input": {
      "packet": "8000002a0000",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Truncated: the RTP fixed header needs 12 bytes at offset 0, but the packet ends at 6.",
      "input": "packet",
      "at": 0,
      "len": 6
    }
  },
  {
    "name": "version 1 is not RTP, and saying so beats decoding it anyway",
    "input": {
      "packet": "4000002a000000a0deadbeef",
      "view": "all"
    },
    "expect": {
      "kind": "error",
      "message": "Version is 1, but RTP is always version 2. This is probably not an RTP packet.",
      "input": "packet",
      "at": 0,
      "len": 1
    }
  }
