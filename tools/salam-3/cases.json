[
	{
		"name": "the default name: four letters in two pieces, because أ never joins the letter after it",
		"input": { "name": "أحمد", "greeting": "ahlan", "ya": true },
		"expect": {
			"kind": "group",
			"parts": [
				{ "kind": "text", "text": "أهلاً يا أحمد" },
				{
					"kind": "fields",
					"fields": [
						{ "label": "Letters", "value": "4" },
						{ "label": "Pieces", "value": "2", "note": "أ · حمد" },
						{ "label": "UTF-8 bytes", "value": "8", "note": "two for each Arabic letter or mark, one for a space" }
					]
				},
				{
					"kind": "table",
					"caption": "Letter by letter",
					"columns": [
						{ "label": "Letter" },
						{ "label": "Name" },
						{ "label": "Code point", "mono": true },
						{ "label": "UTF-8", "mono": true },
						{ "label": "Joins the next" }
					],
					"rows": [
						["أ", "alif, hamza above", "U+0623", "D8 A3", "no"],
						["ح", "ḥa", "U+062D", "D8 AD", "yes"],
						["م", "mim", "U+0645", "D9 85", "yes"],
						["د", "dal", "U+062F", "D8 AF", "no"]
					]
				},
				{
					"kind": "bytes",
					"bytes": [216, 163, 216, 173, 217, 133, 216, 175],
					"caption": "The name in UTF-8, one highlighted run per letter",
					"highlight": [
						{ "at": 0, "len": 2, "label": "U+0623 alif, hamza above" },
						{ "at": 2, "len": 2, "label": "U+062D ḥa" },
						{ "at": 4, "len": 2, "label": "U+0645 mim" },
						{ "at": 6, "len": 2, "label": "U+062F dal" }
					]
				}
			]
		}
	},
	{
		"name": "Latin letters are refused, and the message points at the first one",
		"input": { "name": "Ahmed", "greeting": "ahlan", "ya": true },
		"expect": {
			"kind": "error",
			"message": "\"A\" is not an Arabic letter. Write the name in Arabic letters, for example أحمد.",
			"input": "name",
			"at": 0,
			"len": 1
		}
	}
]
