{
  "sdk": 8,
  "id": "stun-decoder",
  "name": "STUN message decoder",
  "blurb": "Paste a STUN message as hex or a Wireshark hex dump: what it is, what to fix, every attribute with addresses un-XORed, and its integrity checked, TURN long-term credentials included.",
  "version": "3.0.0",
  "capabilities": [
    "pure"
  ],
  "runtime": {
    "entry": "index.ts",
    "thread": "main"
  },
  "kinds": [
    "group",
    "fields",
    "table",
    "bytes",
    "error"
  ],
  "card": "live",
  "cardFields": 3,
  "inputs": [
    {
      "id": "message",
      "share": false,
      "type": "textarea",
      "label": "Message",
      "description": "Hex, however you copied it.",
      "details": "A hex stream, bytes with spaces or colons, or a hex dump from Wireshark, tcpdump or xxd. A captured frame's Ethernet, IP and UDP headers are skipped.",
      "primary": true,
      "dir": "ltr",
      "rows": 6,
      "maxLength": 8192,
      "default": "0101000c 2112a442 b7e7a701 bc5ca493 5d339347 00200008 0001f523 e112a648"
    },
    {
      "id": "password",
      "share": false,
      "type": "text",
      "label": "Password",
      "description": "Optional, to check MESSAGE-INTEGRITY. For ICE, the ice-pwd of the side that receives the check. For TURN, the account's password. It never leaves this page.",
      "default": ""
    },
    {
      "id": "username",
      "type": "text",
      "label": "Username",
      "description": "Only for a TURN response, which does not repeat it. A message's own USERNAME is used when it has one.",
      "default": ""
    },
    {
      "id": "realm",
      "type": "text",
      "label": "Realm",
      "description": "Only for a TURN response, the same way. With a realm, the key is MD5 of username:realm:password rather than the password.",
      "default": ""
    },
    {
      "id": "view",
      "type": "select",
      "label": "Byte view",
      "description": "The byte view marks the header and every attribute in place.",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Show the bytes"
        },
        {
          "value": "fields",
          "label": "Hide the bytes"
        }
      ]
    }
  ],
  "samples": [
    {
      "label": "Binding request",
      "input": {
        "message": "00010000 2112a442 b7e7a701 bc5ca493 5d339347",
        "password": "",
        "username": "",
        "realm": "",
        "view": "all"
      }
    },
    {
